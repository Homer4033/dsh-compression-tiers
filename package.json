{
  "name": "dsh-compression-tiers",
  "version": "1.1.1",
  "private": false,
  "type": "module",
  "description": "Five-tier context compression policy for official DeepSeek Harness plus a global rules editor: settings page, agent tools, live occupancy meter, proactive compaction, and $DSH_HOME/AGENTS.md.",
  "license": "MIT",
  "author": "Homer",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context",
    "compaction",
    "rules"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Homer4033/dsh-compression-tiers.git"
  },
  "bugs": {
    "url": "https://github.com/Homer4033/dsh-compression-tiers/issues"
  },
  "homepage": "https://github.com/Homer4033/dsh-compression-tiers#readme",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.3"
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
